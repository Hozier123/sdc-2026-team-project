* text=auto
*.pdf binary

# Seed manifests sign LF bytes. Windows checkout must not change them.
data/seed/*.sql text eol=lf

# Preserve the signed Gate 0 baseline byte-for-byte across platforms.
gate0/** -text
evidence/gate0/确认书.md -text

# tests/contract.test.ts pins SHA-256 of these exact bytes in contracts/provenance.json.
# Without -text, `* text=auto` rewrites CRLF to LF in the index and the check fails on a
# fresh clone. Keep frontend fixtures and the frozen contract snapshot byte-identical.
frontend/tests/fixtures/** -text
frontend/contracts/** -text

# Blocker evidence must keep Zhou's original bytes and SHA.
evidence/e2e/blocker/** -text

# Post55 E2E evidence must keep Zhou's original bytes and SHA.
evidence/e2e/post55/** -text

# T2 E2E evidence must keep its original bytes and SHA.
evidence/e2e/t2/** -text

# The B04 evidence auditor binds this signed driver's exact LF bytes.
backend/tools/run_workflow.py text eol=lf
backend/tools/verify_t2_local.py text eol=lf
docs/ops/b04-cases/*.json text eol=lf
backend/tests/fixtures/b04-audit-direct.zip binary
