  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "4.5.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
