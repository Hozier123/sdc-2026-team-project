# Default connection address for the real Gate 0 backend (FastAPI, port 8000).
# Copy to .env.local when the backend runs somewhere else. .env.local is git-ignored.
# Never put a token or secret in a VITE_ variable: anything here ships in the bundle.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Optional development/hosting asset prefix (public, no credentials).
VITE_PAGES_BASE=/sdc-2026-team-project/
