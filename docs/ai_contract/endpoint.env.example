# ==============================================================================
# KiraOrder AI Endpoint Environment Configuration Template
# Conforms to Gate 0 v4 Contract and AI H1/H5 Extraction Interface
# DO NOT COMMIT PRODUCTION SECRETS (API KEYS) TO VERSION CONTROL
# ==============================================================================

# RunPod Serverless API Key (Bearer token authentication)
# Obtain from RunPod Settings -> API Keys (Leave blank to use local offline RapidFuzz fallback)
RUNPOD_API_KEY=

# RunPod Serverless Endpoint Identifier (e.g. vllm-xxxx-xxxx)
# Base URL: https://${RUNPOD_ENDPOINT_ID}.api.runpod.ai/v1/chat/completions
# Health Probe: https://${RUNPOD_ENDPOINT_ID}.api.runpod.ai/v1/version
RUNPOD_ENDPOINT_ID=

# AI Model Name hosted on RunPod vLLM worker
MODEL_NAME=Qwen/Qwen2.5-7B-Instruct-AWQ

# Request Timeout in Seconds (Synchronous extraction threshold)
# p50 warm ~800ms, p95 warm ~1.8s. Recommend 8.0s before degrading to RapidFuzz fallback.
LLM_TIMEOUT_S=8.0

# Path to Gate 0 H1 Field Evidence Lexicon (field-evidence-v2.json)
# Used by deterministic H1 coordinate projection and offline fallback engine
KIRAORDER_FIELD_EVIDENCE_PATH=gate0/contracts/lexicons/field-evidence-v2.json
